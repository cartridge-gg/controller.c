namespace controller {
    // Utility functions
    [Throws=ControllerError]
    boolean validate_felt(string felt);
    
    [Throws=ControllerError]
    ControllerFieldElement get_public_key(ControllerFieldElement private_key);
    
    [Throws=ControllerError]
    ControllerFieldElement signer_to_guid(ControllerFieldElement private_key);
    
    // Controller class hash helper
    [Throws=ControllerError]
    ControllerFieldElement get_controller_class_hash(Version version);
    
    // Check if controller has storage
    [Throws=ControllerError]
    boolean controller_has_storage(string app_id);

    // Build and shorten the session registration URL (POST /s)
    [Throws=ControllerError]
    string create_session_registration_url(
        string private_key,
        SessionPolicies policies,
        string rpc_url,
        string keychain_url,
        string cartridge_api_url
    );
};

// Type aliases
[Custom]
typedef string ControllerFieldElement;

// Error type
[Error]
enum ControllerError {
    "InitializationError",
    "SignupError",
    "ExecutionError",
    "NetworkError",
    "StorageError",
    "InvalidInput",
    "DisconnectError",
};

// Enums
enum SignerType {
    "Webauthn",
    "Starknet",
};

enum Version {
    "V1_0_4",
    "V1_0_5",
    "V1_0_6",
    "V1_0_7",
    "V1_0_8",
    "V1_0_9",
    "Latest",
};

// Core types
dictionary Call {
    ControllerFieldElement contract_address;
    string entrypoint;
    sequence<ControllerFieldElement> calldata;
};

dictionary SessionPolicy {
    ControllerFieldElement contract_address;
    string entrypoint;
};

dictionary SessionPolicies {
    sequence<SessionPolicy> policies;
    ControllerFieldElement max_fee;
};

// Owner interface
interface Owner {
    [Throws=ControllerError, Name=new]
    constructor(string private_key);
};

// ControllerAccount interface
interface ControllerAccount {
    [Throws=ControllerError, Name=new]
    constructor(
        string app_id,
        string username,
        ControllerFieldElement class_hash,
        string rpc_url,
        Owner owner,
        ControllerFieldElement address,
        ControllerFieldElement chain_id
    );
    
    [Throws=ControllerError, Name=new_headless]
    constructor(
        string app_id,
        string username,
        ControllerFieldElement class_hash,
        string rpc_url,
        Owner owner,
        ControllerFieldElement chain_id
    );
    
    [Throws=ControllerError, Name=from_storage]
    constructor(string app_id);
    
    [Throws=ControllerError]
    void signup(SignerType signer_type, u64? session_expiration, string? cartridge_api_url);
    
    [Throws=ControllerError]
    ControllerFieldElement address();
    
    [Throws=ControllerError]
    string username();
    
    [Throws=ControllerError]
    string app_id();
    
    [Throws=ControllerError]
    ControllerFieldElement chain_id();
    
    [Throws=ControllerError]
    void disconnect();
    
    [Throws=ControllerError]
    ControllerFieldElement execute(sequence<Call> calls);
    
    [Throws=ControllerError]
    void switch_chain(string rpc_url);
    
    [Throws=ControllerError]
    ControllerFieldElement delegate_account();
    
    [Throws=ControllerError]
    ControllerFieldElement transfer(ControllerFieldElement recipient, ControllerFieldElement amount);
    
    [Throws=ControllerError]
    string error_message();
    
    void clear_last_error();
};

// SessionAccount interface
interface SessionAccount {
    [Throws=ControllerError, Name=new]
    constructor(
        string rpc_url,
        string private_key,
        ControllerFieldElement address,
        ControllerFieldElement owner_guid,
        ControllerFieldElement chain_id,
        SessionPolicies policies,
        u64 session_expiration
    );
    
    [Throws=ControllerError, Name=create_from_subscribe]
    constructor(
        string private_key,
        SessionPolicies policies,
        string rpc_url,
        string cartridge_api_url
    );
    
    [Throws=ControllerError]
    ControllerFieldElement execute(sequence<Call> calls);
    
    [Throws=ControllerError]
    ControllerFieldElement execute_from_outside(sequence<Call> calls);
    
    // Getter methods for session metadata
    string address();
    string chain_id();
    string owner_guid();
    u64 expires_at();
    boolean is_expired();
    
    // Additional metadata from GraphQL response
    string? session_id();
    string? username();
    string? app_id();
    boolean is_revoked();
};
